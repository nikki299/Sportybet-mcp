{
  "name": "sportybet-mcp",
  "version": "1.0.0",
  "description": "Local MCP server exposing SportyBet football fixtures, markets, odds and non-staking booking-code preparation to AI agents (OpenCode).",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "bot": "tsx src/telegram-bot.ts",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.mts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "grammy": "^1.46.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
